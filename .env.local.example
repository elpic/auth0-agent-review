# ─── Auth0 Core ────────────────────────────────────────────────────────────────
# A long, secret, random string (openssl rand -hex 32)
AUTH0_SECRET=your_auth0_secret_here

# The URL of your running application
AUTH0_BASE_URL=http://localhost:3000

# Your Auth0 tenant domain (e.g. https://dev-xxxxx.us.auth0.com)
AUTH0_ISSUER_BASE_URL=https://your-tenant.auth0.com

# Regular Web Application credentials from Auth0 dashboard
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret

# ─── Auth0 Token Vault ─────────────────────────────────────────────────────────
# Auth0 AI Token Vault API endpoint (from Auth0 AI dashboard)
AUTH0_TOKEN_VAULT_URL=https://your-tenant.us.auth0.com/api/v2

# ─── GitHub (Token Vault Social Connection) ────────────────────────────────────
# OAuth App credentials registered in GitHub Developer Settings
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# ─── Slack (Token Vault Social Connection) ─────────────────────────────────────
# OAuth App credentials registered in Slack API Dashboard
SLACK_CLIENT_ID=your_slack_oauth_client_id
SLACK_CLIENT_SECRET=your_slack_oauth_client_secret

# ─── AI Provider ───────────────────────────────────────────────────────────────
# Choose one: OpenAI or Anthropic
OPENAI_API_KEY=sk-your_openai_api_key_here
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# ─── Database (SQLite for local dev) ───────────────────────────────────────────
# File path for the local SQLite database
DATABASE_URL="file:./dev.db"
